# APP
APP_NAME="Web Application Backend"
APP_SERVER_HEADER="Web Application Backend"
APP_PORT=8080
APP_ENV=development
APP_COMPRESS_LEVEL=1
# Comma-separated list of allowed origins. Empty means "*" with credentials
# disabled in development; production requires the explicit origins.
APP_CORS_ALLOWED_ORIGINS=
APP_JWT_SECRET="example"
APP_JWT_EXPIRE_HOURS=24

# Database
DB_DSN="postgres://username:password@localhost:5432/dbname?sslmode=disable"
DB_MAX_OPEN_CONNS=25
DB_MIN_OPEN_CONNS=0
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_HEALTH_CHECK_PERIOD=1m

# Logger
LOG_LEVEL=debug

# Timezone
APP_TIMEZONE=Asia/Jakarta

# RabbitMQ
RABBITMQ_URL=amqp://username:password@localhost:5672/

# Redis
REDIS_HOST=localhost
REDIS_DB=0
REDIS_PASSWORD=
REDIS_PORT=6379
